{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Falkon IDE",
  "version": "1.136.0",
  "identifier": "com.falkon.ide",
  "build": {
    "beforeBuildCommand": "node falkon/build/bundle-vscode.js",
    "beforeDevCommand": "node falkon/build/bundle-vscode.js",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Falkon IDE",
        "width": 1400,
        "height": 900,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "maximized": true,
        "theme": "Dark",
        "backgroundColor": "#181818",
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": false
  }
}
