{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Code - OSS",
  "version": "1.133.0",
  "identifier": "com.falkon.devkit",
  "build": {
    "beforeBuildCommand": "",
    "beforeDevCommand": "",
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Code - OSS",
        "width": 1400,
        "height": 900,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "maximized": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self' http://127.0.0.1:9888 ws://127.0.0.1:9888 https: data: blob: 'unsafe-inline' 'unsafe-eval'; connect-src 'self' http://127.0.0.1:9888 ws://127.0.0.1:9888 https: blob: data:; img-src 'self' http://127.0.0.1:9888 https: data: blob:; font-src 'self' http://127.0.0.1:9888 https: data:;"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": false
  }
}
