{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Falkon IDE",
  "version": "1.133.0",
  "identifier": "com.falkon.ide",
  "build": {
    "beforeBuildCommand": "node bundle-vscode-tauri.js",
    "beforeDevCommand": "node bundle-vscode-tauri.js",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Falkon IDE",
        "width": 1400,
        "height": 900,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "maximized": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self' tauri: https: data: blob: 'unsafe-inline' 'unsafe-eval'; connect-src 'self' tauri: https: wss: blob: data:; img-src 'self' tauri: https: data: blob:; font-src 'self' tauri: https: data:; worker-src 'self' blob: data:;"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": false
  }
}
